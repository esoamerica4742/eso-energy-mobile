{
  "expo": {
    "name": "eso-energy-mobile",
    "slug": "eso-energy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "esoenergy",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060809",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "alerts"
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://ssmcnzsvrcxfbgufvoed.supabase.co",
      "supabaseAnonKey": "",
      "enodeApiUrl": "https://ssmcnzsvrcxfbgufvoed.supabase.co/functions/v1/enode-api",
      "webAppUrl": "https://ssmcnzsvrcxfbgufvoed.supabase.co",
      "enodeRedirectUri": "esoenergymobile://link-device/callback",
      "easProjectId": "",
      "_comment": "supabaseAnonKey is filled from .env by app.config.js when you run expo start"
    }
  }
}
