# Mobile-only setup — copy to .env and fill YOUR_PROJECT_REF + anon key (eyJ...)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_ENODE_REDIRECT_URI=esoenergymobile://link-device/callback

# Eso Pay / Monnify — app calls Supabase BFF only (never put Monnify keys here)
EXPO_PUBLIC_ESO_PAY_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/eso-pay-api

# Optional: EXPO_PUBLIC_ENODE_API_URL=  EXPO_PUBLIC_WEB_APP_URL=

# Monnify sandbox secrets → Supabase Edge only. See docs/MONNIFY_SANDBOX_MOBILE.md

# Supabase dashboard (same project):
#   Auth → Email ON (monitoring login)
#   Auth → Phone ON + SMS (Eso Pay login)
#
# After editing: npx expo start -c
